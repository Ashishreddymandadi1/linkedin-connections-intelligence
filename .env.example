# ─────────────────────────────────────────────────────────────
# LinkedIn Connections Intelligence — environment config
# Copy to  backend/.env  and fill in.  NEVER commit backend/.env
# ─────────────────────────────────────────────────────────────

# ── Apify (LinkedIn profile enrichment) ──────────────────────
APIFY_API_TOKEN=
APIFY_ACTOR_ID=LpVuK3Zozwuipa5bp
APIFY_PROFILE_SCRAPER_MODE=Profile details no email ($4 per 1k)

# ── LLM providers — priority chain (V4 §2) ─────────────────
# Order when configured:  Anthropic → Groq primary → Groq fallback → OpenRouter
# → local/deterministic.  Unconfigured providers are simply skipped.
GROQ_API_KEY=
OPENROUTER_API_KEY=
GROQ_PRIMARY_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
LLM_MAX_RETRIES=2

# ── Anthropic (preferred when set) ─────────────────────────
# A CONFIGURED key is the opt-in (V4 §1) — set ANTHROPIC_API_KEY and Anthropic
# is tried first, ahead of Groq. No separate enable flag needed.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Only for "identity-linked" keys (accounts with multiple workspaces). A normal
# console key works without it.
ANTHROPIC_WORKSPACE_ID=
# DEPRECATED — no longer gates Anthropic. Left readable for old .env files.
ENABLE_PAID_LLM=false
ANTHROPIC_FIRST=true

# ── Provider circuit breaker (V4 §8, process-local, not persisted) ─
LLM_PROVIDER_COOLDOWN_SECONDS=90               # transient (429 / 5xx / transport)
ANTHROPIC_CONFIG_FAILURE_COOLDOWN_SECONDS=900  # bad key / workspace / model

# ── Embeddings (local sentence-transformers, no key, no cost) ─
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# ── Database (SQLite for MVP; swap DATABASE_URL for Postgres) ─
DATABASE_URL=sqlite:///./data/app.db

# ── Enrichment / cost controls ──────────────────────────────
ENVIRONMENT=development
USE_FIXTURES=true
DEVELOPMENT_BATCH_SIZE=5
PRODUCTION_BATCH_SIZE=50
APIFY_PROFILE_BATCH_SIZE=50
MAX_APIFY_RETRIES=2
APIFY_MAX_CHARGE_USD=0
PROFILE_TTL_DAYS=30

# ── Search ──────────────────────────────────────────────────
CANDIDATE_POOL_SIZE=60
TOP_CONNECTIONS=20
MIN_MATCH_SCORE=12
SEMANTIC_ENABLED=true

# ── Search quality v2 ───────────────────────────────────────
RELEVANCE_WEIGHT=20                # points for whole-profile relevance (embedding + reranker)
RERANKER_ENABLED=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
RERANK_POOL=40
RERANK_BLEND=0.6                   # cross-encoder share within the relevance component
LLM_RERANK_ENABLED=false           # opt-in LLM reorder of the final top 20
RECENCY_WEIGHTING_ENABLED=true
COMPANY_ID_MATCHING=true

# ── Exhaustive semantic judge (V4 PART 3) ───────────────────
# off | uncertain_only | all_viable.  all_viable = judge EVERY candidate that
# passes the hard-fact gate (correct for a ~1k network; costs LLM tokens).
SEMANTIC_JUDGE_MODE=all_viable
# 0 = NO artificial cap after hard-fact gating. A positive value caps the judged
# set and the response reports judge_metadata.capped=true (never a silent cap).
SEMANTIC_JUDGE_MAX_CANDIDATES=0
SEMANTIC_JUDGE_BATCH_SIZE=10
SEMANTIC_JUDGE_MAX_PACKET_CHARS=7000
SEMANTIC_JUDGE_MAX_BATCH_CHARS=48000

# ── Final result audit (V4 PART 5) ─────────────────────────
# ONE grounded LLM correctness review of the candidates about to be shown.
# Downgrade / remove only — it can never upgrade POSSIBLE->EXACT or invent a
# score. Set to false to skip it entirely.
FINAL_RESULT_AUDIT_ENABLED=true
FINAL_RESULT_AUDIT_TOP_N=20
FINAL_RESULT_AUDIT_BUFFER=10
FINAL_RESULT_AUDIT_BATCH_SIZE=10
FINAL_RESULT_AUDIT_MAX_PACKET_CHARS=6000
FINAL_RESULT_AUDIT_MAX_BATCH_CHARS=44000

# ── Current-user profile (V4 PART 2) ────────────────────────
# Only used to resolve relational queries like "anyone in my field" or
# "a mentor in my space". Leave blank and such a query is marked UNRESOLVED
# (confidence is lowered) instead of the searcher's field being guessed.
USER_FIELD=
USER_CURRENT_ROLE=
USER_GOAL=

# ── App ─────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5182,http://127.0.0.1:5182
LOG_LEVEL=INFO
